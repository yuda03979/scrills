#!/usr/bin/env python3
# scrills: skills you import instead of read. Stdlib only, driven from bash in any harness.
#
# A scrill is a folder in a .scrills directory: <name>/__init__.py plus its manual, opening with
# SKILL.md-style frontmatter. Two files, two purposes: a SKILL.md beside __init__.py is the
# manual - the one a person reads - and a docstring explains its own file; without a SKILL.md
# the module docstring carries the manual (the one-file shape). When SKILL.md exists, a
# frontmattered docstring is ignored as a manifest and list says so. Two layers, project over user: the nearest
# .scrills walking up from the cwd (never the user library, never the default ~/.scrills even
# when SCRILLS_HOME points elsewhere, and never one owned by another uid - that one is ignored
# aloud, the CVE-2022-24765 class), then the user library at $SCRILLS_HOME or ~/.scrills, which
# also hosts the generated .venv. A folder whose name starts with '_' is an invisible draft.
# A folder that can never resolve as a scrill - a name that is not a valid identifier, or a
# missing or dangling __init__.py, which Python would otherwise import as an empty namespace
# package - is named with its reason by list and by run's refusal, never silently skipped. A
# project scrill shadowing a different user scrill is process-wide - other scrills' imports get
# the project one - so py and run say so in one stderr line. A stray <name>.py at a layer root
# resolves the same way (a scrill folder beats it within its own layer), joins that notice, and
# list points at it.
#
# The venv is the runtime; this CLI is a thin dispatcher. The resolver lives inside the venv
# (site-packages/_scrills_pth.py + scrills.pth, copied from scripts/_scrills_pth.py beside this
# file and rewritten atomically whenever the bundled source changes): at every interpreter start
# it synthesizes the `scrills` package over the layer dirs in $SCRILLS_LAYERS (else the user
# library), so siblings import relatively, one scrill imports
# another with `from scrills import <name>`, and worker processes the venv python spawns can
# import scrills too. The CLI relaunches itself onto the venv python when one exists, so the same
# interpreter parses, gates, and runs - no version skew between check and execution. Every child
# runs -I (cwd and PYTHONPATH can never shadow an import; project code belongs to the project's
# own tooling) with pycache redirected to <home>/.pycache so committed .scrills folders stay
# clean.
#
# `py` and `run` both execv the venv python, so the pid is real and signals stay natural. `py`
# runs stdin once: stdout passes through, the trailing expression echoes like a REPL (capped at
# $SCRILLS_ECHO_CAP chars, default 8192, 0 = uncapped), top level may await, the snippet runs in
# a real __main__ module, and nothing persists between calls. Code travels to the child over
# stdin, never argv, so secrets stay out of ps. Both verbs execv the venv python onto
# scripts/_boot.py, a real file beside this one - no generated source: the run context travels as
# JSON in SCRILLS_BOOT_CTX (popped the moment the boot starts, so nothing downstream sees it) and
# the child's argv carries no code at all. For run, the boot clears its __main__ file identity so
# multiprocessing spawn/forkserver workers don't re-execute the boot as the user's main file.
# `run <name>` executes a scrill that defines main() as a program (console-scripts idiom:
# sys.argv is set, main()'s return value is the exit code; an async main is awaited). Runnability
# is gated once, in the boot after the import
# (callable(module.main)) under the interpreter that actually runs the scrill - so a scrill
# without main() has its top level run (imports, constants, defs by convention) before the boot
# refuses with exit 2. `install` hands everything after it to the venv's pip - the one
# explicit write to the shared environment, never implicit. The version lives once, in SKILL.md's
# frontmatter.
#
# Every py/run is registered by the runner, never by the scrill: a live card at
# <home>/.runs/<pid>.json while it runs, one appended line in <home>/.runs/log.jsonl when it
# ends. Metadata only - verb, name, a W3C-shaped run id (a valid TRACEPARENT in the environment
# is joined, and the boot sets TRACEPARENT for everything the run starts, so chained runs share
# one trace; SCRILLS_CLI is set to this file's own path, so a run can spawn nested scrills
# children without relying on PATH - cron and launchd often have none), pid, cwd, who, timing,
# exit (wrapped to 0..255 like the OS wraps it, so the record always equals what the caller
# observed), the scrills the run imported with their versions,
# and on an uncaught exception its type and where it broke (for a compile error, where the
# compiler found it; never a location inside core plumbing, this file or the boot) - never code, argv,
# output, or the exception message. A scrill names the exits its main() chooses in a module
# constant EXITS = {1: "no answer"}; such a run is recorded with status `outcome` and that
# name beside it, instead of `error` - a scrill adds to the record, it never writes core's
# own fields.
# The card is written and flock'd before execv;
# the lock rides the inherited fd into the run (the boot then marks it close-on-exec, so programs
# the run launches never hold it - only pure forks do) and the kernel drops it on any death, so a
# sweep probes the lock, not the pid: lock free = the run died uncleanly, turned into a `died` log
# line - crash visibility with no supervisor, no recycled-pid ghosts (kill(pid, 0) remains only
# as the fallback where flock is unsupported). Sweeps run serialized under a flock, a death is
# appended only when its run id isn't already in the log, and a card is removed only after its
# record lands - a death is recorded exactly once; a card that can't be read or recorded is kept
# and named. The outcome line is written from an atexit hook,
# after non-daemon threads joined, so `ok` means actually finished - and only by the process
# that booted: a forked child inherits the hook but never finalizes the parent's record. `who` comes from
# $SCRILLS_WHO when set (harness extensions and cron lines label themselves; the core sniffs no
# vendor variables), else tty/unknown. `ps` shows running, newly-found-dead, and the last 24h;
# readers hold a shared lock on stable log.lock across both history files, and rotation past 1 MiB
# needs its non-blocking exclusive lock (a blocked writer skips rotation and still appends).
# Registry writes never break a run - any failure degrades to a no-op.
#
# When a run dies on a missing scrill or third-party package, the boot appends one stderr line
# to the traceback - the names that exist, or `scrills install <pkg>`: raised louder, never
# resolved.
#
# Exit codes: 0 ok; a run's own choice passes through (run: main()'s int, wrapped to 0..255 as
# the OS wraps it; py: a SystemExit's code the same way); 1 an exception in scrill or py code;
# 2 usage, unknown scrill, or not runnable; install exits with pip's code.
import ast
import datetime
import fcntl
import glob
import json
import keyword
import os
import re
import subprocess
import sys
import time

SCRIPT = os.path.realpath(__file__)
os.environ["SCRILLS_CLI"] = SCRIPT
SKILL_FILE = os.path.join(os.path.dirname(os.path.dirname(SCRIPT)), "SKILL.md")
BOOT_FILE = os.path.join(os.path.dirname(SCRIPT), "_boot.py")
PTH_SOURCE = os.path.join(os.path.dirname(SCRIPT), "_scrills_pth.py")
USAGE = """usage: scrills <verb>
  list               the library, one "- name: description" line per scrill
  py                 run Python from stdin, once, with the library importable
  run <name> ...     run a scrill that defines main() as a program
  install <pkg> ...  install a package into the shared environment (pip)
  ps                 runs: what's running now, what died, the last 24h
  where              paths: layers, python, how to install a package
  --version          the scrills version"""

def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def user_home():
    raw = os.environ.get("SCRILLS_HOME", "").strip() or os.path.join(os.path.expanduser("~"), ".scrills")
    return os.path.abspath(os.path.expanduser(raw))


def project_dir(home):
    default = os.path.realpath(os.path.join(os.path.expanduser("~"), ".scrills"))
    step = os.getcwd()
    while True:
        candidate = os.path.join(step, ".scrills")
        if os.path.isdir(candidate):
            real = os.path.realpath(candidate)
            if real != os.path.realpath(home) and real != default:
                try:
                    owner = os.stat(candidate).st_uid
                except OSError:
                    owner = None
                if owner is not None and owner != os.getuid():
                    return None, (candidate, owner)
                return candidate, None
        parent = os.path.dirname(step)
        if parent == step:
            return None, None
        step = parent


def layers():
    home = user_home()
    project, foreign = project_dir(home)
    found = []
    if project is not None:
        found.append(("project", project))
    if os.path.isdir(home):
        found.append(("user", home))
    return home, found, foreign


def warn_foreign(foreign):
    if foreign is not None:
        print(f"scrills: ignoring {foreign[0]} as the project layer - owned by uid {foreign[1]}, not you", file=sys.stderr)


def warn_shadows(found):
    layered = dict(found)
    project, user = layered.get("project"), layered.get("user")
    if not project or not user:
        return
    user_side = providers(user)
    names = []
    for name, entry in sorted(providers(project).items()):
        theirs = user_side.get(name)
        if theirs is None or os.path.realpath(entry) == os.path.realpath(theirs):
            continue
        names.append(name if os.path.basename(entry) == "__init__.py" else f"{name} (a stray {os.path.basename(entry)})")
    if names:
        print(
            f"scrills: project scrills shadow user ones for this run: {', '.join(names)}"
            " (process-wide - imports inside other scrills get the project one)",
            file=sys.stderr,
        )


def caller_project(home, found):
    if any(label == "project" for label, _ in found):
        return None
    default = os.path.realpath(os.path.join(os.path.expanduser("~"), ".scrills"))
    for entry in os.environ.get("SCRILLS_LAYERS", "").split(os.pathsep):
        if entry and os.path.realpath(entry) not in (os.path.realpath(home), default):
            return entry
    return None


def warn_lost_project(home, found):
    caller = caller_project(home, found)
    if caller is not None:
        print(
            f"scrills: no project layer - the caller had one ({caller}); spawn children from the project root to keep it",
            file=sys.stderr,
        )


def scan(directory):
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return {}
    found = {}
    for name in names:
        if name.startswith(("_", ".")) or not name.isidentifier():
            continue
        entry = os.path.join(directory, name, "__init__.py")
        if os.path.isfile(entry):
            found[name] = entry
    return found


def stray_scan(directory):
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return {}
    found = {}
    for filename in names:
        stem, extension = os.path.splitext(filename)
        if extension == ".py" and not filename.startswith(("_", ".")) and stem.isidentifier():
            found[stem] = os.path.join(directory, filename)
    return found


def ignored_entries(directory):
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return []
    found = []
    for name in names:
        if name.startswith(("_", ".")):
            continue
        entry = os.path.join(directory, name)
        if not os.path.isdir(entry):
            continue
        init = os.path.join(entry, "__init__.py")
        if not name.isidentifier():
            if os.path.lexists(init) or os.path.isfile(os.path.join(entry, "SKILL.md")):
                found.append((name, "not a valid Python identifier - the folder name is the import name; rename it, e.g. - to _"))
            continue
        if os.path.isfile(init):
            continue
        if os.path.lexists(init):
            found.append((name, "__init__.py is a dangling symlink or not a file"))
        elif os.path.isfile(os.path.join(entry, "SKILL.md")):
            found.append((name, "a skill folder - add __init__.py to make it a scrill (today it imports as an empty namespace package)"))
        else:
            try:
                has_python = any(item.endswith(".py") for item in os.listdir(entry))
            except OSError as error:
                found.append((name, f"cannot inspect the folder: {error.strerror or error}"))
                continue
            if has_python:
                found.append((name, "no __init__.py - __init__.py is always the entry (today it imports as an empty namespace package)"))
    return found


def known_names(found_layers):
    known = {}
    for _, directory in found_layers:
        for name in providers(directory):
            known.setdefault(name, name)
    return sorted(known)


def providers(directory):
    merged = dict(stray_scan(directory))
    merged.update(scan(directory))
    return merged


def resolved_providers(found_layers):
    merged = {}
    for label, directory in found_layers:
        for name, entry in providers(directory).items():
            merged.setdefault(
                name,
                {"name": name, "entry": entry, "layer": label, "stray": os.path.basename(entry) != "__init__.py"},
            )
    return merged


def library(found_layers):
    merged = {}
    shadowed = []
    for label, directory in found_layers:
        for name, entry in scan(directory).items():
            if name in merged:
                shadowed.append((name, label))
            else:
                merged[name] = {"name": name, "entry": entry, "layer": label}
    return merged, shadowed


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def read_source(path):
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        return None


def classify(text):
    lines = text.strip().split("\n")
    if lines[0].strip() == "---":
        for end in range(1, len(lines)):
            if lines[end].strip() == "---":
                return lines[: end + 1], "frontmatter"
        return [lines[0]], "unclosed"
    first = next((line.strip() for line in lines if line.strip()), "")
    return ([first] if first else []), "prose"


def manifest(entry):
    skill_lines = skill_kind = None
    skill_text = read_text(os.path.join(os.path.dirname(entry), "SKILL.md"))
    if skill_text is not None:
        skill_lines, skill_kind = classify(skill_text)
    source = read_source(entry)
    problem = doc = None
    if source is None:
        problem = "(unreadable)"
    else:
        try:
            doc = ast.get_docstring(ast.parse(source))
        except (SyntaxError, ValueError) as error:
            problem = f"(doesn't parse: {error})"
    doc_lines, doc_kind = classify(doc) if doc is not None else (None, None)
    if skill_kind is not None:
        extra = [problem] if problem else []
        if doc_kind in ("frontmatter", "unclosed"):
            extra.append("(the docstring also opens with frontmatter - ignored: SKILL.md is the manual, the docstring explains the file)")
        return (skill_lines or ["(empty SKILL.md)"]), skill_kind, True, extra
    if doc_kind is not None:
        return (doc_lines or ["(empty docstring)"]), doc_kind, False, []
    return [problem or "(no module docstring, so it announces nothing)"], None, False, []


def unquote(value):
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        return value[1:-1]
    return value


def unsupported_shape(value):
    if re.match(r"^[|>][+-]?\d*$", value):
        return "uses a YAML block scalar"
    if value[:1] in ("[", "{"):
        return "is a structured value"
    return None


FIELD_KEY = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$")


def frontmatter_fields(lines):
    if len(lines) < 2 or lines[0].strip() != "---" or lines[-1].strip() != "---":
        return {}, []
    consumed = ("name", "description", "version", "compatibility")
    fields = {}
    problems = []
    metadata_version = None
    version_declared = False
    in_metadata = False
    metadata_indent = None
    current = None
    for raw in lines[1:-1]:
        if not raw.strip():
            current = None
            continue
        if raw[:1] not in (" ", "\t"):
            in_metadata = False
            current = None
            match = FIELD_KEY.match(raw.strip())
            if match is None:
                continue
            key, value = match.group(1), match.group(2).strip()
            if key == "metadata":
                in_metadata = True
                continue
            if key == "version":
                version_declared = True
            if key not in consumed:
                continue
            shape = unsupported_shape(value)
            if shape is not None:
                problems.append(f"({key} {shape} - scrills frontmatter takes one-line values)")
                continue
            fields[key] = unquote(value)
            current = key
            continue
        depth = len(raw) - len(raw.lstrip())
        if in_metadata:
            if metadata_indent is None:
                metadata_indent = depth
            if depth != metadata_indent:
                continue
            match = FIELD_KEY.match(raw.strip())
            if match is not None and match.group(1) == "version" and metadata_version is None:
                value = match.group(2).strip()
                if value and unsupported_shape(value) is None:
                    metadata_version = unquote(value)
            continue
        if current is not None:
            problems.append(f"({current} continues on the next line - scrills frontmatter takes one-line values)")
            fields.pop(current, None)
            current = None
    if version_declared and metadata_version is not None:
        problems.append("(version declared in both places - keep one; the top-level value wins)")
    if not fields.get("version") and metadata_version is not None:
        fields["version"] = metadata_version
    return fields, problems


def entry_description(lines, kind):
    if kind == "frontmatter":
        fields, _ = frontmatter_fields(lines)
        return fields.get("description", "")
    if kind == "unclosed":
        return ""
    return lines[0]


def notices(name, lines, kind, filed=False):
    found = []
    if keyword.iskeyword(name):
        found.append(f"(python keyword - `from scrills import {name}` won't parse; rename, or reach it via run/importlib)")
    if kind == "unclosed":
        return found + ["(frontmatter never closes - missing the second ---)"]
    if kind == "prose":
        where = "SKILL.md" if filed else "the docstring or a SKILL.md beside it"
        return found + [f"(no frontmatter - open {where} with ---, name/description/version, ---)"]
    if kind != "frontmatter":
        return found
    fields, problems = frontmatter_fields(lines)
    found.extend(problems)
    stated = fields.get("name", "")
    if stated and stated != name:
        found.append(f"(frontmatter name '{stated}' differs from folder '{name}' - the folder name is the import name)")
    for key in ("description", "version"):
        if not fields.get(key):
            found.append(f"(no {key} in frontmatter)")
    return found


def venv_python(home):
    return os.path.join(home, ".venv", "bin", "python")


def write_ignore(directory):
    path = os.path.join(directory, ".gitignore")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("*\n")


def runs_dir(home):
    return os.path.join(home, ".runs")


def card_path(home, pid):
    return os.path.join(runs_dir(home), f"{pid}.json")


def log_path(home):
    return os.path.join(runs_dir(home), "log.jsonl")


def log_lock_path(home):
    return os.path.join(runs_dir(home), "log.lock")


def take_log_lock(home, operation):
    fd = None
    try:
        fd = os.open(log_lock_path(home), os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(fd, operation)
        return fd
    except OSError:
        if fd is not None:
            os.close(fd)
        return None


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def who():
    explicit = os.environ.get("SCRILLS_WHO", "").strip()
    if explicit:
        return explicit
    try:
        return "tty" if sys.stderr.isatty() else "unknown"
    except (AttributeError, OSError, ValueError):
        return "unknown"


def lineage():
    raw = os.environ.get("TRACEPARENT", "").strip().lower()
    match = re.match(r"^([0-9a-f]{2})-([0-9a-f]{32})-([0-9a-f]{16})-([0-9a-f]{2})$", raw)
    if match and match.group(1) != "ff" and set(match.group(2)) != {"0"} and set(match.group(3)) != {"0"}:
        return match.group(2), match.group(3), match.group(4)
    return os.urandom(16).hex(), None, "01"


def alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def append_log(home, record):
    lock = None
    try:
        directory = runs_dir(home)
        os.makedirs(directory, exist_ok=True)
        write_ignore(directory)
        lock = take_log_lock(home, fcntl.LOCK_EX | fcntl.LOCK_NB)
        path = log_path(home)
        handle = open(path, "a", encoding="utf-8")
        try:
            if lock is not None and os.path.getsize(path) > 1048576:
                os.replace(path, os.path.join(directory, "log.prev.jsonl"))
                handle.close()
                handle = open(path, "a", encoding="utf-8")
            handle.write(json.dumps(record) + "\n")
        finally:
            handle.close()
        return True
    except (OSError, ValueError, TypeError):
        return False
    finally:
        if lock is not None:
            os.close(lock)


def sweep_lock(home):
    try:
        directory = runs_dir(home)
        os.makedirs(directory, exist_ok=True)
        fd = os.open(os.path.join(directory, "sweep.lock"), os.O_RDWR | os.O_CREAT, 0o644)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        os.close(fd)
        return None
    return fd


def recorded_ids(home):
    return {record["id"] for record in log_records(home) if isinstance(record.get("id"), str) and record["id"]}


def load_card(path):
    text = read_text(path)
    if text is None:
        return None
    try:
        card = json.loads(text)
    except ValueError:
        return None
    return card if isinstance(card, dict) else None


def register(home, verb, name, layer, pid, run_id, trace, parent):
    card = {"verb": verb, "name": name, "id": run_id, "trace": trace, "pid": pid, "cwd": os.getcwd(), "who": who(), "started": now_iso()}
    if parent is not None:
        card["parent"] = parent
    if layer is not None:
        card["layer"] = layer
    try:
        directory = runs_dir(home)
        os.makedirs(directory, exist_ok=True)
        write_ignore(directory)
        path = card_path(home, pid)
        if os.path.exists(path):
            lock = sweep_lock(home)
            try:
                stale = load_card(path)
                if stale is not None:
                    stale_id = stale.get("id")
                    if not (isinstance(stale_id, str) and stale_id and stale_id in recorded_ids(home)):
                        append_log(home, {**stale, "status": "died", "pruned": now_iso()})
            finally:
                if lock is not None:
                    os.close(lock)
        tmp = path + ".tmp"
        fd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
        locked = None
        try:
            os.write(fd, json.dumps(card).encode("utf-8"))
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                os.set_inheritable(fd, True)
                locked = fd
            except OSError:
                pass
            os.replace(tmp, path)
        except OSError:
            os.close(fd)
            raise
        return card, locked
    except OSError:
        return None, None


def held(path, pid):
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        except OSError:
            return alive(pid)
        return False
    finally:
        os.close(fd)


def sweep(home):
    running, recorded, unrecorded = [], [], []
    directory = runs_dir(home)
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return running, recorded, unrecorded
    if not any(name.endswith(".json") and name[:-5].isdigit() for name in names):
        return running, recorded, unrecorded
    lock = sweep_lock(home)
    try:
        candidates = []
        for filename in names:
            stem, extension = os.path.splitext(filename)
            if extension != ".json" or not stem.isdigit():
                continue
            path = os.path.join(directory, filename)
            card = load_card(path)
            if card is None:
                if os.path.exists(path):
                    print(f"scrills ps: cannot read {path} (left in place)", file=sys.stderr)
                continue
            pid = card["pid"] if isinstance(card.get("pid"), int) else int(stem)
            if held(path, pid):
                running.append(card)
            else:
                candidates.append((path, card))
        known = recorded_ids(home) if candidates else set()
        for path, card in candidates:
            ident = card.get("id")
            if isinstance(ident, str) and ident and ident in known:
                try:
                    os.remove(path)
                except OSError:
                    pass
                continue
            if append_log(home, {**card, "status": "died", "pruned": now_iso()}):
                if isinstance(ident, str) and ident:
                    known.add(ident)
                try:
                    os.remove(path)
                except OSError:
                    pass
                recorded.append(card)
            else:
                unrecorded.append(card)
    finally:
        if lock is not None:
            os.close(lock)
    return running, recorded, unrecorded


def writable_library_error(home, path, error):
    fail(
        f"scrills: cannot use {path}: {error.strerror or error}\n"
        f"The user library ({home}) must be a writable directory - fix it, or point SCRILLS_HOME at one"
    )


def venv_ready_path(home):
    return os.path.join(home, ".venv", ".scrills-ready")


def venv_ready(home):
    return read_text(venv_ready_path(home)) == "1\n" and os.path.exists(venv_python(home))


def mark_venv_ready(home):
    path = venv_ready_path(home)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write("1\n")
        os.replace(tmp, path)
    except OSError as error:
        fail(
            f"scrills: cannot mark the environment ready at {path}: {error.strerror or error}\n"
            f"Fix the permissions, or delete {os.path.join(home, '.venv')} and rerun"
        )


def validate_venv(home):
    target = os.path.join(home, ".venv")
    python = venv_python(home)

    def refuse(reason):
        fail(
            f"scrills: {target} is not a complete environment ({reason}).\n"
            f"Rebuild it: rm -rf {target}  - then rerun, and reinstall any packages (scrills install ...)"
        )

    if not os.path.isdir(target):
        refuse("not a directory")
    if not os.path.isfile(os.path.join(target, "pyvenv.cfg")):
        refuse("no pyvenv.cfg")
    if not os.path.exists(python):
        refuse("bin/python is missing or dangling")
    if site_packages(home) is None:
        refuse("no site-packages")
    prefix_check = "import sys, os; sys.exit(0 if os.path.realpath(sys.prefix) == os.path.realpath(sys.argv[1]) and sys.prefix != sys.base_prefix else 3)"
    for command, reason in (
        ([python, "-I", "-c", prefix_check, target], "its python does not identify it as its own environment"),
        ([python, "-I", "-m", "pip", "--isolated", "install", "--help"], "its pip cannot run - likely an interrupted first build"),
    ):
        try:
            result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            refuse(reason)
            return
        if result.returncode != 0:
            refuse(reason)


def ensure_venv(home):
    python = venv_python(home)
    if venv_ready(home):
        return python
    target = os.path.join(home, ".venv")
    if os.path.lexists(python) and not os.path.exists(python):
        fail(
            f"scrills: {python} points at a python that no longer exists (removed or upgraded).\n"
            f"Rebuild the environment: rm -rf {target}  - then rerun, and reinstall any packages (scrills install ...)"
        )
    try:
        os.makedirs(runs_dir(home), exist_ok=True)
        write_ignore(runs_dir(home))
    except OSError as error:
        writable_library_error(home, runs_dir(home), error)
    lock_path = os.path.join(runs_dir(home), "venv.lock")
    lock = None
    try:
        lock = open(lock_path, "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError as error:
        if lock is not None:
            lock.close()
        writable_library_error(home, lock_path, error)
    with lock:
        if venv_ready(home):
            return python
        if not os.path.exists(target):
            print(f"creating the scrills environment at {target} (first run, a few seconds)", file=sys.stderr)
            result = subprocess.run(
                [sys.executable, "-m", "venv", target],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            if result.returncode != 0 or not os.path.exists(python):
                detail = result.stdout.strip() or f"exit {result.returncode}"
                fail(f"scrills: creating the environment at {target} failed: {detail}\nCreate it by hand: {sys.executable} -m venv {target}")
            write_ignore(target)
        validate_venv(home)
        mark_venv_ready(home)
    return python


def site_packages(home):
    venv = os.path.join(home, ".venv")
    cfg = read_text(os.path.join(venv, "pyvenv.cfg"))
    if cfg:
        for line in cfg.splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "version" and value.strip():
                stated = os.path.join(venv, "lib", "python" + ".".join(value.strip().split(".")[:2]), "site-packages")
                if os.path.isdir(stated):
                    return stated
                break

    def order(path):
        found = re.match(r"python(\d+)\.(\d+)$", os.path.basename(os.path.dirname(path)))
        return (int(found.group(1)), int(found.group(2))) if found else (0, 0)

    matches = sorted(glob.glob(os.path.join(venv, "lib", "python*", "site-packages")), key=order)
    return matches[-1] if matches else None


def ensure_pth(home):
    site = site_packages(home)
    if site is None:
        fail(f"scrills: {os.path.join(home, '.venv')} has no site-packages; delete it and rerun to rebuild")
    wrote = False
    pth_source = read_text(PTH_SOURCE)
    if pth_source is None:
        fail(f"scrills: {PTH_SOURCE} is missing - reinstall keeping the scrills/ folder intact")
    for filename, text in (
        ("_scrills_pth.py", pth_source),
        ("scrills.pth", "import _scrills_pth; _scrills_pth.install()\n"),
        ("scrills.start", "_scrills_pth:install\n"),
    ):
        path = os.path.join(site, filename)
        if read_text(path) == text:
            continue
        tmp = f"{path}.{os.getpid()}.tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write(text)
            os.replace(tmp, path)
            wrote = True
        except OSError as error:
            fail(f"scrills: cannot install the resolver at {path}: {error}\nFix the permissions, or delete {os.path.join(home, '.venv')} and rerun")
    if wrote:
        check = subprocess.run(
            [venv_python(home), "-I", "-c", "import scrills"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        if check.returncode != 0:
            detail = (check.stdout or "").strip() or f"exit {check.returncode}"
            fail(
                f"scrills: the resolver was written to {site}, but this venv's python does not run it: {detail}\n"
                f"Rebuild the environment: rm -rf {os.path.join(home, '.venv')}  - then rerun"
            )


def ensure_runtime(home):
    python = ensure_venv(home)
    ensure_pth(home)
    for folder in (".pycache", ".state"):
        try:
            path = os.path.join(home, folder)
            os.makedirs(path, exist_ok=True)
            write_ignore(path)
        except OSError:
            pass
    return python


def child_flags(home):
    return ["-I", "-X", "pycache_prefix=" + os.path.join(home, ".pycache")]


def boot_ctx(home, verb, card, lock_fd, started, run_id, trace, flags, known):
    return {
        "verb": verb,
        "card": card,
        "card_path": card_path(home, os.getpid()),
        "lock_fd": lock_fd,
        "log": log_path(home),
        "prev": os.path.join(runs_dir(home), "log.prev.jsonl"),
        "started": started,
        "traceparent": "00-" + trace + "-" + run_id + "-" + flags,
        "known": known,
    }


def boot_path():
    if not os.path.isfile(BOOT_FILE):
        fail(f"scrills: {BOOT_FILE} is missing - reinstall keeping the scrills/ folder intact")
    return BOOT_FILE


def version():
    text = read_text(SKILL_FILE)
    if text is None:
        return "unknown (SKILL.md missing next to the script - reinstall keeping the scrills/ folder intact)"
    inside = False
    under_metadata = False
    for line in text.splitlines():
        if line.strip() == "---":
            if inside:
                break
            inside = True
            continue
        if not inside:
            continue
        if re.match(r"^\S", line):
            under_metadata = line.strip() == "metadata:"
            continue
        match = re.match(r"^\s+version:\s*(\S+)\s*$", line) if under_metadata else None
        if match:
            value = match.group(1)
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            return value
    return "unknown (no metadata.version in SKILL.md's frontmatter)"


def export_layers(found):
    os.environ["SCRILLS_LAYERS"] = os.pathsep.join(directory for _, directory in found)


def cmd_py(argv):
    if argv:
        fail(f"scrills py: unknown argument {argv[0]}\n{USAGE}", 2)
    if sys.stdin is None or sys.stdin.isatty():
        fail("scrills py: no code on stdin. Pass it as a heredoc:\n  scrills py <<'PY'\n  ...\n  PY", 2)
    boot = boot_path()
    home, found, foreign = layers()
    warn_foreign(foreign)
    warn_shadows(found)
    warn_lost_project(home, found)
    python = ensure_runtime(home)
    export_layers(found)
    run_id = os.urandom(8).hex()
    trace, parent, flags = lineage()
    card, lock_fd = register(home, "py", "py", None, os.getpid(), run_id, trace, parent)
    os.environ["SCRILLS_BOOT_CTX"] = json.dumps(boot_ctx(home, "py", card, lock_fd, time.time(), run_id, trace, flags, known_names(found)))
    os.execv(python, [python, *child_flags(home), boot])


def cmd_run(argv):
    if not argv:
        fail("usage: scrills run <name> [args...]", 2)
    name = argv[0]
    boot = boot_path()
    home, found, foreign = layers()
    warn_foreign(foreign)
    warn_shadows(found)
    warn_lost_project(home, found)
    resolved = resolved_providers(found)
    provider = resolved.get(name)
    if provider is not None and provider["stray"]:
        stray = provider["entry"]
        fail(f"scrills run: {name} is a stray module - not runnable; import it from py (from scrills import {name}) or fold it into {os.path.join(os.path.dirname(stray), name, '__init__.py')}", 2)
    if provider is None:
        for _, directory in found:
            reason = dict(ignored_entries(directory)).get(name)
            if reason is not None:
                fail(f"scrills run: {name} can't run - {reason}", 2)
        available = ", ".join(sorted(entry for entry, detail in resolved.items() if not detail["stray"])) or "none yet"
        fail(f"scrills run: there's no scrill named {name} (available: {available})", 2)
    python = ensure_runtime(home)
    export_layers(found)
    run_id = os.urandom(8).hex()
    trace, parent, flags = lineage()
    card, lock_fd = register(home, "run", name, provider["layer"], os.getpid(), run_id, trace, parent)
    os.environ["SCRILLS_BOOT_CTX"] = json.dumps(boot_ctx(home, "run", card, lock_fd, time.time(), run_id, trace, flags, known_names(found)))
    os.execv(python, [python, *child_flags(home), boot, name, *argv[1:]])


def cmd_install(argv):
    if not argv:
        fail("usage: scrills install <package> [pip args...]", 2)
    home, _, _ = layers()
    python = ensure_runtime(home)
    os.execv(python, [python, *child_flags(home), "-m", "pip", "install", *argv])


def stray_modules(found_layers):
    return [
        (os.path.basename(path), label, stem)
        for label, directory in found_layers
        for stem, path in sorted(stray_scan(directory).items())
    ]


def cmd_list(argv):
    if argv:
        fail(f"scrills list: unknown argument {argv[0]}\n{USAGE}", 2)
    home, found, foreign = layers()
    warn_foreign(foreign)
    merged, shadowed = library(found)
    strays = stray_modules(found)
    ignored = [(label, name, reason) for label, directory in found for name, reason in ignored_entries(directory)]
    if not merged:
        where = " or ".join(directory for _, directory in found) or home
        print(f"no scrills yet; the library is {where}")
        if not strays and not ignored:
            return
    layer_dirs = dict(found)
    project_strays = {stem for label, directory in found if label == "project" for stem in stray_scan(directory)}
    for name in sorted(merged):
        lines, kind, filed, extra = manifest(merged[name]["entry"])
        print(f"- {name}: {entry_description(lines, kind)}".rstrip())
        for notice in notices(name, lines, kind, filed) + extra:
            print(f"  {notice}")
    for name, layer in shadowed:
        print(f"{name}  ({layer}, shadowed by {merged[name]['layer']})")
    for filename, layer, stem in strays:
        beaten = merged.get(stem)
        if stem in scan(layer_dirs[layer]):
            print(f"{filename}  ({layer}, stray module - the {stem}/ folder beside it wins; fold it into the folder)")
        elif layer == "user" and stem in project_strays:
            print(f"{filename}  (user, stray module - shadowed by the project's {stem}.py; invisible here)")
        elif layer == "user" and beaten is not None and beaten["layer"] == "project":
            print(f"{filename}  (user, stray module - shadowed by the project scrill {stem}; invisible here)")
        elif layer == "project" and beaten is not None and beaten["layer"] == "user":
            print(f"{filename}  (project, stray module - shadows the user scrill {stem}: imports get this file; fold it into a folder)")
        else:
            print(f"{filename}  ({layer}, stray module - importable as scrills.{stem}, invisible here; fold it into a folder)")
    for label, name, reason in ignored:
        print(f"{name}  ({label}, ignored - {reason})")


def tilde(path):
    if not isinstance(path, str):
        return "?"
    homedir = os.path.expanduser("~")
    if path == homedir or path.startswith(homedir + os.sep):
        return "~" + path[len(homedir):]
    return path


def age(started):
    try:
        begin = datetime.datetime.fromisoformat(started)
        seconds = max(0, int((datetime.datetime.now(begin.tzinfo) - begin).total_seconds()))
    except (TypeError, ValueError):
        return "?"
    for unit, span in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= span:
            return f"{seconds // span}{unit}"
    return f"{seconds}s"


def clock(started):
    return started[11:16] if isinstance(started, str) and len(started) >= 16 else "?"


def log_records(home):
    records = []
    directory = runs_dir(home)
    lock = take_log_lock(home, fcntl.LOCK_SH)
    try:
        for filename in ("log.prev.jsonl", "log.jsonl"):
            text = read_text(os.path.join(directory, filename))
            if not text:
                continue
            for line in text.splitlines():
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if isinstance(record, dict):
                    records.append(record)
    finally:
        if lock is not None:
            os.close(lock)
    return records


def within_day(record):
    try:
        begin = datetime.datetime.fromisoformat(record.get("started", ""))
    except (TypeError, ValueError):
        return False
    seconds = (datetime.datetime.now(begin.tzinfo) - begin).total_seconds()
    return 0 <= seconds <= 86400


def cmd_ps(argv):
    if argv:
        fail(f"scrills ps: unknown argument {argv[0]}\n{USAGE}", 2)
    home, _, _ = layers()
    running, died, unrecorded = sweep(home)
    lines = []
    if running:
        lines.append("running:")
        for card in running:
            lines.append(
                f"  {card.get('name', '?')}  pid {card.get('pid', '?')}  {age(card.get('started'))}"
                f"  {tilde(card.get('cwd', '?'))}  ({card.get('who', '?')})"
            )
    else:
        lines.append("running: nothing")
    if died:
        lines.append("died (found now, recorded):")
        for card in died:
            lines.append(
                f"  {card.get('name', '?')}  pid {card.get('pid', '?')}  started {clock(card.get('started'))}"
                f"  {tilde(card.get('cwd', '?'))}"
            )
    if unrecorded:
        lines.append("died (found now, could not record - card kept, will retry):")
        for card in unrecorded:
            lines.append(
                f"  {card.get('name', '?')}  pid {card.get('pid', '?')}  started {clock(card.get('started'))}"
                f"  {tilde(card.get('cwd', '?'))}"
            )
    day = [record for record in log_records(home) if within_day(record)]
    if day:
        errors = [record for record in day if record.get("status") == "error"]
        counts, named = {}, {}
        for record in day:
            status = record.get("status")
            status = status if isinstance(status, str) and status else "?"
            counts[status] = counts.get(status, 0) + 1
            if status == "outcome":
                name = record.get("outcome")
                name = name if isinstance(name, str) and name else "?"
                named[name] = named.get(name, 0) + 1
        parts = [f"{counts.get('ok', 0)} ok"]
        if named:
            breakdown = ", ".join(f"{count} {name}" for name, count in sorted(named.items()))
            parts.append(f"{counts['outcome']} outcome ({breakdown})")
        parts.extend(
            f"{count} {status}" for status, count in sorted(counts.items()) if status not in ("ok", "outcome", "error", "died")
        )
        parts.extend((f"{len(errors)} error", f"{counts.get('died', 0)} died"))
        lines.append(f"last 24h: {len(day)} runs - {', '.join(parts)}")
        for record in errors[-5:]:
            detail = ""
            if record.get("error_type"):
                detail = f" - {record['error_type']}"
                if record.get("error_at"):
                    detail += f" at {tilde(str(record['error_at']))}"
            lines.append(
                f"  error: {record.get('name', '?')} exit {record.get('exit', '?')}"
                f" at {clock(record.get('started'))} in {tilde(record.get('cwd', '?'))}{detail}"
            )
    else:
        lines.append("last 24h: no runs recorded")
    lines.append(f"log: {log_path(home)}")
    print("\n".join(lines))


def cmd_where(argv):
    if argv:
        fail(f"scrills where: unknown argument {argv[0]}\n{USAGE}", 2)
    home, found, foreign = layers()
    project = next((directory for label, directory in found if label == "project"), None)
    python = venv_python(home)
    site = site_packages(home)
    if project:
        project_line = f"project: {project}"
    elif foreign:
        project_line = f"project: none (nearest .scrills at {foreign[0]} is owned by uid {foreign[1]}, not you - ignored)"
    else:
        caller = caller_project(home, found)
        tail = f"; the caller had one: {caller}" if caller else ""
        project_line = f"project: none (no .scrills between {os.getcwd()} and /{tail})"
    lines = [
        project_line,
        f"user library: {home}" + ("" if os.path.isdir(home) else "  (not created yet)"),
        f"python: {python}" + ("" if os.path.exists(python) else "  (created by the first py or run call)"),
        f"resolver: {site}" if site else "resolver: none yet  (created with the environment)",
        f"packages: scrills install <package>  (= {python} -m pip install)",
    ]
    print("\n".join(lines))


def relaunch():
    python = venv_python(user_home())
    try:
        if not os.path.exists(python):
            if os.path.lexists(python):
                print(f"scrills: {python} is dangling - staying on {sys.executable}; py or run prints the remedy", file=sys.stderr)
            return
        if os.path.realpath(python) == os.path.realpath(sys.executable):
            return
        os.execv(python, [python, "-I", SCRIPT, *sys.argv[1:]])
    except OSError:
        pass


def main():
    relaunch()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        sys.exit(0 if argv else 2)
    verb, rest = argv[0], argv[1:]
    if verb == "--version":
        if rest:
            fail(f"scrills --version: unknown argument {rest[0]}\n{USAGE}", 2)
        print(version())
    elif verb == "list":
        cmd_list(rest)
    elif verb == "py":
        cmd_py(rest)
    elif verb == "run":
        cmd_run(rest)
    elif verb == "install":
        cmd_install(rest)
    elif verb == "ps":
        cmd_ps(rest)
    elif verb == "where":
        cmd_where(rest)
    else:
        fail(f"scrills: unknown verb {verb}\n{USAGE}", 2)


if __name__ == "__main__":
    main()
